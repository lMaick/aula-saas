# Valores públicos do projeto Supabase. Não coloque service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configuração equivalente para Server Components, Server Actions e proxy.
# Em produção, configure os dois grupos: NEXT_PUBLIC_* para o browser e estas
# variáveis para o runtime server-side. URL e chave publicável podem ter os
# mesmos valores nos dois grupos.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000

# Segredos exclusivamente server-side. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
AULA_SAAS_MONTHLY_PRICE_CENTS=
